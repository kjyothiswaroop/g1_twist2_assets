        def PhysicsFixedJoint "base_fixed"
        {
            rel physics:body1 = </World/neck/base>
            point3f physics:localPos0 = (0.06675706, 0.00005455143, 0.009905555)
            point3f physics:localPos1 = (0, 0, 0)
        }

        def PhysicsRevoluteJoint "joint_yaw_motor"
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </World/neck/base>
            rel physics:body1 = </World/neck/pinion_body>
            point3f physics:localPos0 = (0.016742937, -0.00005455143, 0.015094444)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -197
            float physics:upperLimit = 243
        }

        def PhysicsRevoluteJoint "joint_yaw" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 8
            float drive:angular:physics:maxForce = 10
            float drive:angular:physics:stiffness = 80
            float drive:angular:physics:targetPosition = 23
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Z"
            rel physics:body0 = </World/neck/base>
            rel physics:body1 = </World/neck/yaw_body>
            point3f physics:localPos0 = (0.037242938, -0.00005455143, 0.015094444)
            point3f physics:localPos1 = (-0.0005, 1.1115001e-15, -0.0012583333)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -97
            float physics:upperLimit = 143
        }

        def PhysxPhysicsGearJoint "gear_yaw"
        {
            custom rel physics:body0 = </World/neck/yaw_body>
            custom rel physics:body1 = </World/neck/pinion_body>
            custom bool physics:excludeFromArticulation = 1
            custom float physics:gearRatio = 1.1
            custom rel physics:hinge0 = </World/neck/joint_yaw>
            custom rel physics:hinge1 = </World/neck/joint_yaw_motor>
        }

        def PhysicsRevoluteJoint "joint_pitch_motor" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 6
            float drive:angular:physics:maxForce = 8
            float drive:angular:physics:stiffness = 60
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Z"
            rel physics:body0 = </World/neck/pitch_body>
            rel physics:body1 = </World/neck/wheel>
            point3f physics:localPos0 = (-0.010010078, 0.0020339445, 0.0048977416)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.70710677, -0.59827065, 0.37692466, 0)
            quatf physics:localRot1 = (0.70710677, -0.59827065, 0.37692466, 0)
            float physics:lowerLimit = -30
            float physics:upperLimit = 90
        }

        def PhysicsRevoluteJoint "joint_pitch"
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </World/neck/yaw_body>
            rel physics:body1 = </World/neck/pitch_body>
            point3f physics:localPos0 = (0.0021, 0.0034, 0.020141667)
            point3f physics:localPos1 = (0.017089922, -0.012166056, -0.024402259)
            quatf physics:localRot0 = (0.70710677, -0.59827065, 0.37692466, 0)
            quatf physics:localRot1 = (0.70710677, -0.59827065, 0.37692466, 0)
            float physics:lowerLimit = -30
            float physics:upperLimit = 90
        }

        def PhysxPhysicsGearJoint "gear_pitch"
        {
            custom rel physics:body0 = </World/neck/wheel>
            custom rel physics:body1 = </World/neck/pitch_body>
            custom bool physics:excludeFromArticulation = 1
